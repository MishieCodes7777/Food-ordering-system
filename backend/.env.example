DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=akio_db
PORT=5000
JWT_SECRET=your_jwt_secret_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Set to "production" on a real deployment — enables secure cookies,
# trust proxy, and TLS on the DB connection.
NODE_ENV=development

# Only needed if frontend and backend are deployed on different origins.
# Leave unset for local dev / same-site deployments (defaults to "strict").
# COOKIE_SAME_SITE=none

# Required for Google sign-in (customer + admin). Leave unset to disable
# Google sign-in entirely — the server will reject those requests with 503
# rather than silently skip audience verification.
# GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_running_seedAdmin

# Only needed if you run more than one backend instance (e.g. behind a load
# balancer). Without it, rate limiting / login lockout / logout token
# blacklist each fall back to in-memory state that isn't shared across
# instances — fine for a single instance, broken for horizontal scaling.
# REDIS_URL=redis://localhost:6379

# Required to actually send OTP SMS via MSG91 during registration. Leave
# unset for local dev — the OTP is logged server-side and returned in the
# API response as `dev_otp` instead of being texted. Requires an OTP
# template created in the MSG91 dashboard first.
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_TEMPLATE_ID=your_msg91_otp_template_id_here
# MSG91_OTP_VARIABLE_NAME=OTP

# Required to text the customer when an admin marks their order "ready" for
# pickup. Leave unset for local dev — it's logged server-side instead of
# texted. Needs its own template in the MSG91 dashboard (separate from the
# OTP one — MSG91 templates are fixed pre-approved content per message type)
# with two variables matching the names below.
# MSG91_ORDER_READY_TEMPLATE_ID=your_msg91_order_ready_template_id_here
# MSG91_CUSTOMER_NAME_VARIABLE_NAME=NAME
# MSG91_ORDER_ID_VARIABLE_NAME=ORDERID